<Window x:Class="RecortadorDeVideos.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:enums="clr-namespace:RecortadorDeVideos.Domain.Enums;assembly=RecortadorDeVideos.Domain"
        mc:Ignorable="d"
        Title="Recortador de Videos MP4 - Sin Pérdida de Calidad (Lossless)"
        Height="780" Width="1050"
        MinHeight="650" MinWidth="850"
        Background="{StaticResource PrimaryBackground}"
        Foreground="{StaticResource TextPrimary}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Fila 0: Barra superior / Selector de archivo -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 1: Área de Video y Reproductor -->
            <RowDefinition Height="*"/>
            <!-- Fila 2: Línea de Tiempo y Marcadores -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 3: Configuración de Audio -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 4: Barra de Progreso y Acciones -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Fila 0: Cabecera y Selector -->
        <Border Grid.Row="0" Background="{StaticResource SecondaryBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="📁 Abrir Video MP4" 
                        Click="OpenVideo_Click" 
                        Padding="14,8" Background="{StaticResource AccentColor}" 
                        Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                <TextBlock Grid.Column="1" Text="{Binding VideoFileName}" 
                           VerticalAlignment="Center" Margin="14,0" 
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding DurationString, StringFormat='Duración: {0}'}" 
                           VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
            </Grid>
        </Border>

        <!-- Fila 1: Reproductor de Video -->
        <Border Grid.Row="1" Background="Black" CornerRadius="8" Margin="0,0,0,12" ClipToBounds="True">
            <Grid>
                <MediaElement x:Name="VideoPlayer" 
                              LoadedBehavior="Manual" 
                              UnloadedBehavior="Stop"
                              ScrubbingEnabled="True"
                              MediaOpened="VideoPlayer_MediaOpened"/>
                
                <!-- Overlay si no hay video cargado -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasNoVideo, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Arrastra y suelta un archivo MP4 aquí o pulsa 'Abrir Video'" 
                               Foreground="{StaticResource TextSecondary}" FontSize="16" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Fila 2: Controles de Tiempo y Marcadores -->
        <Border Grid.Row="2" Background="{StaticResource SecondaryBackground}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <!-- Slider de reproducción -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CurrentPositionString}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Slider Grid.Column="1" x:Name="TimelineSlider" 
                            Minimum="0" Maximum="100" 
                            ValueChanged="TimelineSlider_ValueChanged"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding DurationString}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>

                <!-- Botones de reproducción y fijación de marcadores -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnPlayPause" Content="▶ Reproducir" Click="BtnPlayPause_Click" 
                                Padding="12,6" Margin="0,0,8,0" Background="{StaticResource CardBackground}" Foreground="White"/>
                        <Button Content="⏹ Detener" Click="BtnStop_Click" 
                                Padding="12,6" Background="{StaticResource CardBackground}" Foreground="White"/>
                    </StackPanel>

                    <!-- Marcadores de Recorte -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="[ Fijar Inicio" Command="{Binding SetStartToCurrentCommand}" 
                                Padding="10,6" Margin="0,0,8,0" Background="{StaticResource CardBackground}" Foreground="White"/>
                        <TextBlock Text="{Binding StartTimeString, StringFormat='Desde: {0}'}" 
                                   VerticalAlignment="Center" Margin="0,0,14,0" FontWeight="Bold"/>

                        <Button Content="] Fijar Fin" Command="{Binding SetEndToCurrentCommand}" 
                                Padding="10,6" Margin="0,0,8,0" Background="{StaticResource CardBackground}" Foreground="White"/>
                        <TextBlock Text="{Binding EndTimeString, StringFormat='Hasta: {0}'}" 
                                   VerticalAlignment="Center" Margin="0,0,14,0" FontWeight="Bold"/>

                        <Border Background="{StaticResource AccentColor}" CornerRadius="4" Padding="8,4">
                            <TextBlock Text="{Binding TrimDurationString, StringFormat='Recorte: {0}'}" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Fila 3: Configuración de Audio -->
        <Border Grid.Row="3" Background="{StaticResource SecondaryBackground}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Gestión de Audio (Sin pérdida de calidad de video)" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="Conservar Original" IsChecked="True" 
                                 Checked="AudioMode_Checked" Tag="KeepOriginal" 
                                 Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <RadioButton Content="Silenciar Video (Mute)" 
                                 Checked="AudioMode_Checked" Tag="Mute" 
                                 Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <RadioButton Content="Reemplazar Audio" 
                                 Checked="AudioMode_Checked" Tag="Replace" 
                                 Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <RadioButton Content="Mezclar Audio de Fondo" 
                                 Checked="AudioMode_Checked" Tag="Mix" 
                                 Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <Button Content="🎵 Cargar Audio" Click="OpenAudio_Click" 
                            Padding="10,4" Margin="0,0,8,0" Background="{StaticResource CardBackground}" Foreground="White"/>
                    <TextBlock Text="{Binding AudioFileName}" VerticalAlignment="Center" 
                               Foreground="{StaticResource TextSecondary}" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Fila 4: Barra de Progreso y Botón de Recorte -->
        <Border Grid.Row="4" Background="{StaticResource SecondaryBackground}" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding StatusMessage}" Margin="0,0,0,6" Foreground="{StaticResource TextSecondary}"/>
                    <ProgressBar Height="10" Minimum="0" Maximum="100" 
                                 Value="{Binding ProgressPercentage}" 
                                 Foreground="{StaticResource AccentColor}" Background="{StaticResource CardBackground}"/>
                </StackPanel>

                <Button Grid.Column="1" Content="⚡ Recortar Sin Pérdida" 
                        Command="{Binding TrimCommand}"
                        Padding="20,12" Background="{StaticResource AccentColor}" 
                        Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
